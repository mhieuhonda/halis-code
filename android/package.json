{
  "name": "halis-code-android",
  "productName": "Halis Code",
  "version": "0.3.0",
  "description": "Halis Code for Android — the mobile companion of the desktop coding agent (Telegraph + swarm, no local file or shell tools).",
  "author": "mhieuhonda <mhieuhonda@users.noreply.github.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync": "vite build && cap sync android",
    "open": "cap open android",
    "assets": "capacitor-assets generate --android --assetPath assets"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "viem": "^2.57.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.1.10"
  }
}
